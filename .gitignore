# external datasets (large, licensed by their owners)
data/external/

# converted PFF / SkillCorner tracking (~1.2 GB, rebuilt by convert_pff.py / convert_skillcorner.py); the registries stay
data/pff/processed/
data/skillcorner/processed/

# videos (too large for git; rebuilt by the grf_*/team_league scripts) and smoke-test leftovers
*.mp4
outputs/team_policy/smoke_*

# GRF engine copies with real player names (scripts/grf_names.py)
.grf_engine/
outputs/tuning/preds/

# Phase A vision: local env, SoccerNet GSR data (licensed, re-fetched by fetch_gsr_sample.py), annotated frames
.venv-vision/
data/soccernet_gsr/
data/soccernet_gsr_full/
outputs/vision_poc/rfdetr/
outputs/vision_poc/*/*.jpg
outputs/vision_poc/*/*.png

# third-party open models (code + weights), pinned in hf_models.json and re-fetched from there
models/
# per-row imputation test files (about 57 MB), rebuilt by: impute_offscreen.py bench
outputs/impute/bench_*_players.csv.gz
outputs/impute/bench_*_frames.csv
